# Bug-finding checks only; style is clang-format's job. Generated code
# (games/*/gen) is excluded by tools/lint.sh, which runs this on our sources.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-reserved-identifier,
  -bugprone-assignment-in-if-condition,
  -bugprone-branch-clone,
  -bugprone-switch-missing-default-case,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-signed-bitwise,
  -bugprone-suspicious-string-compare,
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-std-exception-baseclass,
  -bugprone-throwing-static-initialization,
  -bugprone-exception-escape,
  -bugprone-assignment-in-selection-statement,
  -bugprone-macro-parentheses,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  misc-redundant-expression,
  performance-*,
  -performance-no-int-to-ptr,
  -performance-type-promotion-in-math-fn,
  -performance-enum-size,
  -clang-analyzer-optin.performance.Padding,
WarningsAsErrors: ''
HeaderFilterRegex: '(runtime|recompiler|tools)/.*'
FormatStyle: file
