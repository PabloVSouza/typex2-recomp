<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: the launcher's dark blue behind the splash screen (which shows
         the app icon) and the window, so no white frame shows before the page loads. -->
    <style name="Theme.typex2_launcher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
