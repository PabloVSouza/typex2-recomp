{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Type X Recomp",
  "version": "0.1.0",
  "identifier": "io.github.typex2-recomp.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Type X Recomp",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "category": "Game",
    "copyright": "No game files or recompiled game code included.",
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
